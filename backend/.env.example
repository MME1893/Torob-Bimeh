# Copy this to backend/.env. Enter the complete Authorization header value
# captured from your own current browser session if the upstream requires it.
AZKI_AUTHORIZATION=
AZKI_DEVICE_ID=6
# Telemetry only; leave empty unless a request requires it.
AZKI_BAGGAGE=
# Required current token from a successful Bimeh.com browser session (do not commit the value).
BIMEH_TOKEN=

# Server-side LLM configuration. Never expose these values to Vite/browser env.
AI_API_KEY=
OPENROUTER_MODEL=stealth/space-bunny-alpha
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=Torobimeh
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_MAX_TOKENS=3000
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_REASONING_EFFORT=low
# Comma-separated opt-in only. Space Bunny Alpha intentionally uses json_object mode.
OPENROUTER_NATIVE_JSON_SCHEMA_MODELS=
# Reserved for an explicitly enabled future fallback policy; currently unused.
OPENROUTER_FALLBACK_MODELS=
